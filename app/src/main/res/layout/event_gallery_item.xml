<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="#171A27"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:id="@+id/tvGalleryEventName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Annual Hackathon 2026"
        android:textColor="#A78BFA"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvGalleryClubName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="CodeCraft Club"
        android:textColor="#CBD5E1"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvGalleryEventDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="📅 15/09/2026"
        android:textColor="#94A3B8"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvGalleryEventVenue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="📍 Seminar Hall"
        android:textColor="#94A3B8"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="📸 Gallery &amp; Winners will appear here"
        android:textColor="#64748B"
        android:textSize="12sp" />

</LinearLayout>