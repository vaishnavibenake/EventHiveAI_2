<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080A14"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="30dp">

        <!-- Top Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- EventHive Logo -->
            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/logo_background"
                android:gravity="center"
                android:text="E"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EventHive"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Student Portal"
                    android:textColor="#64748B"
                    android:textSize="9sp" />

            </LinearLayout>

            <!-- Notification -->
            <TextView
                android:id="@+id/notificationButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="#171A27"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="🔔"
                android:textSize="17sp" />

        </LinearLayout>

        <!-- Welcome Section -->
        <TextView
            android:id="@+id/studentNameTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Hello, Student 👋"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Discover events happening around your campus"
            android:textColor="#64748B"
            android:textSize="11sp" />

        <!-- Search -->
        <EditText
            android:id="@+id/searchEditText"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/input_background"
            android:hint="🔍  Search events..."
            android:inputType="text"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B"
            android:textSize="11sp" />

        <!-- Recommended Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Recommended For You 🤖"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Recommended Event Card -->
        <LinearLayout
            android:id="@+id/recommendedEventCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#171A27"
            android:orientation="vertical"
            android:padding="15dp">

            <TextView
                android:id="@+id/recommendedEventTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No recommended events yet"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/recommendedEventInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Personalized events will appear here."
                android:textColor="#94A3B8"
                android:textSize="10sp" />

        </LinearLayout>

        <!-- Upcoming Events -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Upcoming Events"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Event Card -->
        <LinearLayout
            android:id="@+id/eventCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#171A27"
            android:orientation="vertical"
            android:padding="15dp">

            <TextView
                android:id="@+id/eventTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Events will appear here"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/eventDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Upcoming college events"
                android:textColor="#94A3B8"
                android:textSize="10sp" />

        </LinearLayout>

        <!-- Campus Winners & Gallery Link -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Hall of Fame &amp; Highlights 🏆"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/winnersGalleryCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#171A27"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:padding="15dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🏆 View Event Winners &amp; Photos"
                android:textColor="#FBBF24"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Check podium champions, team rankings, and campus highlights."
                android:textColor="#94A3B8"
                android:textSize="10sp" />

        </LinearLayout>

        <!-- Bottom Navigation -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="30dp"
            android:background="#11131F"
            android:gravity="center"
            android:orientation="horizontal"
            android:weightSum="4">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="🏠\nHome"
                android:textColor="#8B5CF6"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/eventsNavButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="📅\nEvents"
                android:textColor="#94A3B8"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/notificationsNavButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="🔔\nAlerts"
                android:textColor="#94A3B8"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/profileNavButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="👤\nProfile"
                android:textColor="#94A3B8"
                android:textSize="9sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>

