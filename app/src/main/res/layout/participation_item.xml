<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#171A27"
    android:orientation="vertical"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvPartEventName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Event Name"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPartStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#1E293B"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="REGISTERED"
            android:textColor="#94A3B8"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvPartType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="👤 Individual"
        android:textColor="#A78BFA"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvPartTeam"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="🏷️ Team: ByteMasters"
        android:textColor="#CBD5E1"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvPartDateVenue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="📅 2026-10-25 • 📍 Auditorium"
        android:textColor="#64748B"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvPartAttendance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📋 Pending"
            android:textColor="#94A3B8"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvPartResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text=""
            android:textColor="#F59E0B"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
