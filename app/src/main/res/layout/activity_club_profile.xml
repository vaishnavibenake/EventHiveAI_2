<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0D18"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- TOP BAR -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:rotation="180"
                android:src="@drawable/ic_logout"
                app:tint="#F8FAFC" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="My Club Profile"
                android:textColor="#F8FAFC"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- PROFILE CARD -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="#171A27"
            android:orientation="vertical"
            android:padding="20dp">


            <!-- CLUB NAME -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Club Name"
                android:textColor="#A78BFA"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etClubProfileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:backgroundTint="#A78BFA"
                android:hint="Enter club name"
                android:inputType="textCapSentences"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B"
                android:textSize="16sp" />


            <!-- DEPARTMENT -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Department"
                android:textColor="#A78BFA"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etClubProfileDepartment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:backgroundTint="#A78BFA"
                android:hint="Example: AIML Department"
                android:inputType="textCapSentences"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B"
                android:textSize="14sp" />


            <!-- GOAL -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Club Goal"
                android:textColor="#A78BFA"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etClubProfileGoal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:backgroundTint="#A78BFA"
                android:gravity="top"
                android:hint="What is the main goal of this club?"
                android:inputType="textCapSentences|textMultiLine"
                android:minLines="2"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B"
                android:textSize="14sp" />


            <!-- DESCRIPTION -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Description"
                android:textColor="#A78BFA"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etClubProfileDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:backgroundTint="#A78BFA"
                android:gravity="top"
                android:hint="Describe your club"
                android:inputType="textCapSentences|textMultiLine"
                android:minLines="3"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B"
                android:textSize="14sp" />


            <!-- FOCUS AREAS -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Focus Areas"
                android:textColor="#A78BFA"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etClubProfileFocusAreas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:backgroundTint="#A78BFA"
                android:gravity="top"
                android:hint="Example: AI, Robotics, Coding, Hackathons"
                android:inputType="textCapSentences|textMultiLine"
                android:minLines="2"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B"
                android:textSize="14sp" />


            <!-- DIVIDER -->

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="18dp"
                android:background="#2A2E43" />


            <!-- EMAIL -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Contact Email"
                android:textColor="#A78BFA"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etClubProfileEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:backgroundTint="#A78BFA"
                android:hint="Club contact email"
                android:inputType="textEmailAddress"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B"
                android:textSize="14sp" />


            <!-- PHONE -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Contact Phone"
                android:textColor="#A78BFA"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etClubProfilePhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:backgroundTint="#A78BFA"
                android:hint="Club contact number"
                android:inputType="phone"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B"
                android:textSize="14sp" />


            <!-- SAVE BUTTON -->

            <Button
                android:id="@+id/btnSaveClubProfile"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="#7C3AED"
                android:text="Save Changes"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>