<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EventHiveAI">

        <!-- Launcher Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Authentication -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".StudentSignupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Shared / Core Activities -->
        <activity
            android:name=".EventDetailsActivity"
            android:exported="false" />

        <activity
            android:name=".NotificationsActivity"
            android:exported="false" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <!-- Admin Activities -->
        <activity
            android:name=".admin.AdminDashboardActivity"
            android:exported="false" />

        <activity
            android:name=".admin.ManageEventsActivity"
            android:exported="false" />

        <activity
            android:name=".admin.ManageClubsActivity"
            android:exported="false" />

        <activity
            android:name=".admin.ClubDetailsActivity"
            android:exported="false" />

        <activity
            android:name=".admin.ManageUsersActivity"
            android:exported="false" />

        <activity
            android:name=".admin.AdminCalendarActivity"
            android:exported="false" />

        <activity
            android:name=".admin.AdminReportsActivity"
            android:exported="false" />

        <!-- Coordinator Activities -->
        <activity
            android:name=".coordinator.CoordinatorDashboardActivity"
            android:exported="false" />

        <activity
            android:name=".coordinator.CreateEventActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".coordinator.MyEventsActivity"
            android:exported="false" />

        <activity
            android:name=".coordinator.EditEventActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".coordinator.CoordinatorRegistrationsActivity"
            android:exported="false" />

        <activity
            android:name=".coordinator.UploadWinnersActivity"
            android:exported="false" />

        <activity
            android:name=".coordinator.EventGalleryActivity"
            android:exported="false" />
        <activity
            android:name=".coordinator.EventGalleryDetailsActivity"
            android:exported="false" />
        <activity
            android:name=".coordinator.ClubProfileActivity"
            android:exported="false" />

        <activity
            android:name=".coordinator.CoordinatorAnalyticsActivity"
            android:exported="false" />

        <!-- Student Activities -->
        <activity
            android:name=".student.activity_student_dashboard"
            android:exported="false" />

        <activity
            android:name=".student.MyRegistrationsActivity"
            android:exported="false" />

        <activity
            android:name=".student.TeamRegistrationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".student.MyParticipationActivity"
            android:exported="false" />

        <activity
            android:name=".coordinator.ClubMembersActivity"
            android:exported="false" />

    </application>

</manifest>
